---
import ShieldCheck from '@lucide/astro/icons/shield-check';
import { leaders } from '../data/site';

const partners = leaders.filter((l) => !l.advisor);
const advisors = leaders.filter((l) => l.advisor);
---

<section id="pimpinan" class="bg-sand py-20 sm:py-24 lg:py-32">
  <div class="container-x">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow reveal">Pimpinan</p>
        <h2 class="h-section reveal mt-5" style="--d:80ms">
          Dipimpin profesional lintas disiplin pajak, akuntansi, dan teknologi.
        </h2>
      </div>
      <p class="lead reveal max-w-md lg:text-base" style="--d:140ms">
        Setiap penugasan diawasi langsung oleh partner yang bertanggung jawab atas bidangnya.
      </p>
    </div>

    <ul class="mt-14 grid gap-6 md:grid-cols-3">
      {
        partners.map((l, i) => (
          <li class="card reveal flex flex-col p-7 sm:p-8" style={`--d:${i * 90}ms`}>
            <span class="relative inline-flex size-20 items-center justify-center rounded-full bg-gradient-to-br from-gold-300 via-gold-500 to-gold-700 p-[3px]">
              <span class="inline-flex size-full items-center justify-center rounded-full bg-navy-900 font-display text-2xl font-medium tracking-wide text-gold-300">
                {l.initials}
              </span>
            </span>
            <p class="mt-6 text-xs font-semibold tracking-[0.16em] text-gold-600 uppercase">{l.role}</p>
            <h3 class="mt-2 text-xl font-semibold">{l.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{l.bio}</p>
          </li>
        ))
      }
    </ul>

    {
      advisors.map((l) => (
        <div class="reveal relative mt-6 overflow-hidden rounded-2xl bg-navy-900 p-7 text-white sm:p-9">
          <div class="grid-lines-light pointer-events-none absolute inset-0 opacity-60" aria-hidden="true" />
          <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center">
            <span class="inline-flex size-20 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-gold-300 via-gold-500 to-gold-700 p-[3px]">
              <span class="inline-flex size-full items-center justify-center rounded-full bg-navy-950 font-display text-2xl font-medium text-gold-300">
                {l.initials}
              </span>
            </span>
            <div class="flex-1">
              <p class="inline-flex items-center gap-2 text-xs font-semibold tracking-[0.16em] text-gold-300 uppercase">
                <ShieldCheck class="size-4" aria-hidden="true" />
                {l.role}
              </p>
              <h3 class="mt-2 text-xl font-semibold !text-white">{l.name}</h3>
              <p class="mt-2 max-w-3xl text-sm leading-relaxed text-navy-200">{l.bio}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
