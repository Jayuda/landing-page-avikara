---
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Logo from './Logo.astro';
import { nav } from '../data/site';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300 data-[scrolled=true]:border-navy-900/[0.06] data-[scrolled=true]:bg-white/85 data-[scrolled=true]:shadow-[0_8px_30px_-18px_rgba(11,21,48,0.35)] data-[scrolled=true]:backdrop-blur-xl"
>
  <div class="container-x flex h-20 items-center justify-between gap-6">
    <a href="#top" class="shrink-0">
      <Logo />
    </a>

    <nav aria-label="Navigasi utama" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-full px-4 py-2 text-sm font-medium text-slate-600 transition hover:bg-navy-900/[0.04] hover:text-navy-900"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="#kontak" class="btn btn-primary hidden !py-2.5 sm:inline-flex">
        Hubungi Kami
        <ArrowRight class="size-4" aria-hidden="true" />
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-full text-navy-900 transition hover:bg-navy-900/5 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Buka menu"
      >
        <Menu class="size-6" data-icon="open" aria-hidden="true" />
        <X class="hidden size-6" data-icon="close" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-navy-900/[0.06] bg-white lg:hidden">
    <nav aria-label="Navigasi seluler" class="container-x py-4">
      <ul class="flex flex-col">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-xl px-3 py-3 text-base font-medium text-navy-900 hover:bg-navy-50"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#kontak" class="btn btn-primary mt-3 w-full">
        Hubungi Kami
        <ArrowRight class="size-4" aria-hidden="true" />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    header.dataset.scrolled = String(window.scrollY > 8 || open);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    menu.classList.toggle('hidden', !open);
    toggle.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
    onScroll();
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
