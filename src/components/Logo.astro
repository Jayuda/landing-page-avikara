---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark.png';
import markWhite from '../assets/brand/mark-white.png';

interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: cls = '' } = Astro.props;
const light = variant === 'light';
---

<span class:list={['inline-flex items-center gap-3', cls]}>
  <Image
    src={light ? markWhite : mark}
    alt=""
    width={56}
    height={41}
    densities={[1, 2, 3]}
    class="h-9 w-auto"
    loading="eager"
  />
  <span class="flex flex-col leading-none">
    <span
      class:list={[
        'text-[1.05rem] font-semibold tracking-[0.32em]',
        light ? 'text-white' : 'text-navy-900',
      ]}>AVIKARA</span
    >{' '}
    <span class="mt-1 text-[0.62rem] font-semibold tracking-[0.5em] text-gold-500">GROUP</span>
  </span>
</span>
