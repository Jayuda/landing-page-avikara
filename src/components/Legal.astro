---
import Building2 from '@lucide/astro/icons/building';
import Wallet from '@lucide/astro/icons/wallet';
import PieChart from '@lucide/astro/icons/chart-pie';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import { site, company } from '../data/site';
---

<section id="legalitas" aria-labelledby="legalitas-title" class="py-20 sm:py-24 lg:py-32">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow reveal justify-center">Legalitas Perseroan</p>
      <h2 id="legalitas-title" class="h-section reveal mt-5" style="--d:80ms">
        Struktur kepemilikan, permodalan, dan KBLI.
      </h2>
      <p class="lead reveal mt-5" style="--d:140ms">
        {site.legalName} adalah badan hukum berbentuk perseroan terbatas dengan bidang usaha yang
        terdaftar sesuai Klasifikasi Baku Lapangan Usaha Indonesia.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-12">
      <div class="card reveal p-7 sm:p-8 lg:col-span-5">
        <div class="flex items-center gap-3">
          <span class="inline-flex size-10 items-center justify-center rounded-lg bg-navy-900 text-gold-400">
            <Wallet class="size-5" aria-hidden="true" />
          </span>
          <h3 class="text-lg font-semibold">Permodalan</h3>
        </div>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
          <div class="rounded-xl bg-navy-50 p-4">
            <dt class="text-xs font-semibold tracking-[0.14em] text-navy-700 uppercase">Modal dasar</dt>
            <dd class="mt-1 font-display text-2xl font-medium text-navy-950">{company.authorizedCapital}</dd>
          </div>
          <div class="rounded-xl bg-navy-50 p-4">
            <dt class="text-xs font-semibold tracking-[0.14em] text-navy-700 uppercase">Modal ditempatkan &amp; disetor</dt>
            <dd class="mt-1 font-display text-2xl font-medium text-navy-950">{company.paidUpCapital}</dd>
          </div>
        </dl>

        <div class="mt-8 flex items-center gap-3">
          <span class="inline-flex size-10 items-center justify-center rounded-lg bg-navy-900 text-gold-400">
            <PieChart class="size-5" aria-hidden="true" />
          </span>
          <h3 class="text-lg font-semibold">Komposisi Pemegang Saham</h3>
        </div>
        <ul class="mt-5 space-y-4">
          {
            company.shareholders.map((h) => (
              <li>
                <div class="flex items-baseline justify-between gap-4 text-sm">
                  <span class="font-medium text-navy-900">{h.name}</span>
                  <span class="shrink-0 text-slate-500">
                    <strong class="font-semibold text-navy-900">{h.share}%</strong> · {h.amount}
                  </span>
                </div>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-navy-50" aria-hidden="true">
                  <div class="h-full rounded-full bg-gradient-to-r from-gold-500 to-gold-300" style={`width:${h.share}%`} />
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal relative overflow-hidden rounded-2xl bg-navy-900 p-7 text-white sm:p-8 lg:col-span-7" style="--d:120ms">
        <div class="grid-lines-light pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
        <div class="relative">
          <div class="flex items-center gap-3">
            <span class="inline-flex size-10 items-center justify-center rounded-lg bg-gold-500/15 text-gold-300">
              <ClipboardList class="size-5" aria-hidden="true" />
            </span>
            <h3 class="text-lg font-semibold !text-white">Klasifikasi Baku Lapangan Usaha (KBLI)</h3>
          </div>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {
              company.kbli.map((k) => (
                <li class="rounded-xl border border-white/10 bg-white/[0.04] p-5">
                  <p class="font-display text-3xl font-medium text-gold-300">{k.code}</p>
                  <p class="mt-2 text-sm leading-relaxed text-navy-100">{k.label}</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 flex items-start gap-3 text-sm leading-relaxed text-navy-200">
            <Building2 class="mt-0.5 size-4 shrink-0 text-gold-300" aria-hidden="true" />
            {site.positioning}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
