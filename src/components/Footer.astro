---
import Logo from './Logo.astro';
import { site, nav, services } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-navy-200">
  <div class="container-x grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo variant="light" />
      <p class="mt-6 max-w-sm text-sm leading-relaxed">{site.description}</p>
      <p class="mt-6 font-display text-lg text-gold-300 italic">{site.motto}</p>
    </div>

    <nav aria-label="Tautan footer" class="md:col-span-3">
      <h2 class="text-xs font-semibold tracking-[0.18em] !text-white uppercase">Perusahaan</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {nav.map((n) => <li><a href={n.href} class="transition hover:text-gold-300">{n.label}</a></li>)}
        <li><a href="#kontak" class="transition hover:text-gold-300">Kontak</a></li>
      </ul>
    </nav>

    <div class="md:col-span-4">
      <h2 class="text-xs font-semibold tracking-[0.18em] !text-white uppercase">Layanan</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {services.map((s) => <li><a href="#layanan" class="transition hover:text-gold-300">{s.title}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-3 py-6 text-xs text-navy-300 md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} {site.legalName}. Hak cipta dilindungi.</p>
      <p>Registered Tax Advisory &middot; BKP Level B &middot; Kementerian Keuangan RI</p>
    </div>
  </div>
</footer>
