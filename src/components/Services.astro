---
import { Image } from 'astro:assets';
import Landmark from '@lucide/astro/icons/landmark';
import Calculator from '@lucide/astro/icons/calculator';
import BrainCircuit from '@lucide/astro/icons/brain-circuit';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import Check from '@lucide/astro/icons/check';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { services, type IconName } from '../data/site';

const icons: Record<IconName, typeof Landmark> = {
  landmark: Landmark,
  calculator: Calculator,
  brain: BrainCircuit,
  academy: GraduationCap,
};
---

<section id="layanan" class="py-20 sm:py-24 lg:py-32">
  <div class="container-x">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow reveal">Layanan Kami</p>
        <h2 class="h-section reveal mt-5" style="--d:80ms">
          Solusi terintegrasi untuk setiap tahap pertumbuhan bisnis.
        </h2>
      </div>
      <p class="lead reveal max-w-md lg:text-base" style="--d:140ms">
        Pilih satu layanan atau kombinasikan seluruhnya. Tim kami menyusun ruang lingkup kerja sesuai
        kebutuhan dan skala perusahaan Anda.
      </p>
    </div>

    <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-2">
      {
        services.map((s, i) => {
          const Icon = icons[s.icon];
          return (
            <li
              class:list={[
                'card reveal group flex flex-col overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_50px_-24px_rgba(11,21,48,0.35)]',
              ]}
              style={`--d:${(i % 2) * 90}ms`}
            >
              <div class="relative overflow-hidden">
                <Image
                  src={s.image}
                  alt=""
                  widths={[480, 720, 960]}
                  sizes="(min-width: 768px) 50vw, 92vw"
                  class="aspect-[16/8] w-full object-cover transition duration-700 group-hover:scale-[1.04]"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/55 to-transparent" aria-hidden="true" />
                <span class="absolute bottom-4 left-5 inline-flex size-12 items-center justify-center rounded-xl bg-white text-navy-900 shadow-lg">
                  <Icon class="size-6" aria-hidden="true" />
                </span>
              </div>
              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <p class="text-[0.7rem] font-semibold tracking-[0.16em] text-gold-600 uppercase">{s.unit}</p>
                <h3 class="mt-2 text-xl font-semibold">{s.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{s.desc}</p>
                <ul class="mt-5 space-y-2.5 border-t border-navy-900/[0.06] pt-5">
                  {s.points.map((p) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-700">
                      <Check class="mt-0.5 size-4 shrink-0 text-gold-600" stroke-width={2.5} aria-hidden="true" />
                      {p}
                    </li>
                  ))}
                </ul>
                <a
                  href="#kontak"
                  class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-navy-900 transition hover:text-gold-700"
                  data-service={s.title}
                >
                  Diskusikan kebutuhan Anda
                  <ArrowUpRight class="size-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
                </a>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
